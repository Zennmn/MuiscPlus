# Bundling outputs
/dist/

# Temporary directories used by bundling scripts
/temp_chrome_edge/
/temp_chrome_firefox/
/temp_generic_v2/
/temp

# Mac directory
.DS_Store

# Frontend dependencies and local development cache
/node_modules/
/.vite/

# Kotlin/Wasm and Gradle build state. The staged extension distribution in
# /src/miuix/ is generated by scripts/package-chrome.mjs for each package run.
/ui/miuix/.gradle/
/ui/miuix/.kotlin/
/ui/miuix/build/
/ui/miuix/node_modules/
/ui/miuix/kotlin-js-store/.yarn/
/ui/miuix/kotlin-js-store/node_modules/
/src/miuix/

# Local agent instructions, indexes, and planning records
/.codegraph/
/.planning/
/AGENTS.md
/task_plan.md
/findings.md
/progress.md
/.plan-attestation

# Local settings and credentials
.env
.env.*
!.env.example
!.env.*.example
/.vscode/
/.idea/
*.pem
*.key

# Local logs and browser diagnostics
*.log
*.har
/coverage/
/playwright-report/
/test-results/

# Python bytecode from the optional TTML translation script
__pycache__/
*.py[cod]
